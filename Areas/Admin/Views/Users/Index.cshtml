@model List<AppUser>
@{ ViewData["Title"] = "Users"; }
<h1>Users</h1><a asp-action="Add" class="btn btn-primary mb-3">Add User</a><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Name</th><th>Email</th><th>Major</th><th>SSN</th><th>Date of Birth</th><th>User Type</th><th></th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.Name</td><td>@u.EmailAddress</td><td>@(u.Major?.Name ?? "—")</td><td>@u.SSN</td><td>@u.DateOfBirth?.ToString("d")</td><td>@u.UserType</td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@u.AppUserID" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Delete" asp-route-id="@u.AppUserID" class="btn btn-sm btn-outline-danger">Delete</a></td></tr>}</tbody></table></div>
