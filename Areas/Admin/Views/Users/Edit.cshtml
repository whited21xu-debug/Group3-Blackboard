@model UserViewModel
@{ bool isNew = Model.AppUser.AppUserID == 0; ViewData["Title"] = isNew ? "Add User" : "Edit User"; }
<h1>@ViewData["Title"]</h1><form asp-action="Edit" method="post"><input type="hidden" asp-for="AppUser.AppUserID"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="AppUser.Name" class="form-label"></label><input asp-for="AppUser.Name" class="form-control"/><span asp-validation-for="AppUser.Name" class="text-danger"></span></div><div class="mb-3"><label asp-for="AppUser.EmailAddress" class="form-label">Email Address</label><input asp-for="AppUser.EmailAddress" class="form-control"/><span asp-validation-for="AppUser.EmailAddress" class="text-danger"></span></div><div class="mb-3"><label asp-for="AppUser.MajorID" class="form-label">Major</label><select asp-for="AppUser.MajorID" class="form-select"><option value="">No major</option>@foreach(var m in Model.Majors){<option value="@m.MajorID">@m.Name</option>}</select></div><div class="mb-3"><label asp-for="AppUser.SSN" class="form-label"></label><input asp-for="AppUser.SSN" class="form-control"/><span asp-validation-for="AppUser.SSN" class="text-danger"></span></div><div class="mb-3"><label asp-for="AppUser.DateOfBirth" class="form-label">Date of Birth</label><input asp-for="AppUser.DateOfBirth" class="form-control"/><span asp-validation-for="AppUser.DateOfBirth" class="text-danger"></span></div><div class="mb-3"><label asp-for="AppUser.UserType" class="form-label">User Type</label><select asp-for="AppUser.UserType" class="form-select"><option value="">Select user type</option>@foreach(string type in AppUser.UserTypes){<option value="@type">@type</option>}</select><span asp-validation-for="AppUser.UserType" class="text-danger"></span></div><button class="btn btn-primary" type="submit">Save</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
