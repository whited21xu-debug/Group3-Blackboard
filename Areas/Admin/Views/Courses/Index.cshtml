@model List<Course>
@{ ViewData["Title"] = "Courses"; }
<h1>Courses</h1><a asp-action="Add" class="btn btn-primary mb-3">Add Course</a><div class="table-responsive"><table class="table table-striped table-sm align-middle"><thead><tr><th>Course Number</th><th>Course Name</th><th>Credits</th><th>Semester</th><th>Location</th><th>Hours</th><th>Instructor</th><th>Major</th><th>Short Description</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.CourseNumber</td><td>@c.CourseName</td><td>@c.Credits</td><td>@c.SemesterOffered</td><td>@c.Location</td><td>@c.Hours</td><td>@c.Instructor.Name</td><td>@c.Major.Name</td><td>@c.ShortDescription</td><td class="text-nowrap"><a asp-action="Edit" asp-route-id="@c.CourseID" class="btn btn-sm btn-outline-primary">Edit</a> <a asp-action="Delete" asp-route-id="@c.CourseID" class="btn btn-sm btn-outline-danger">Delete</a></td></tr>}</tbody></table></div>
