@model CourseViewModel
@{ bool isNew = Model.Course.CourseID == 0; ViewData["Title"] = isNew ? "Add Course" : "Edit Course"; }
<h1>@ViewData["Title"]</h1><form asp-action="Edit" method="post"><input type="hidden" asp-for="Course.CourseID"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row">
<div class="col-md-6 mb-3"><label asp-for="Course.CourseNumber" class="form-label"></label><input asp-for="Course.CourseNumber" class="form-control"/><span asp-validation-for="Course.CourseNumber" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="Course.CourseName" class="form-label"></label><input asp-for="Course.CourseName" class="form-control"/><span asp-validation-for="Course.CourseName" class="text-danger"></span></div>
<div class="col-md-3 mb-3"><label asp-for="Course.Credits" class="form-label"></label><input asp-for="Course.Credits" class="form-control"/><span asp-validation-for="Course.Credits" class="text-danger"></span></div>
<div class="col-md-3 mb-3"><label asp-for="Course.SemesterOffered" class="form-label">Semester</label><select asp-for="Course.SemesterOffered" class="form-select"><option value="">Select semester</option>@foreach(string item in Course.Semesters){<option value="@item">@item</option>}</select><span asp-validation-for="Course.SemesterOffered" class="text-danger"></span></div>
<div class="col-md-3 mb-3"><label asp-for="Course.Location" class="form-label"></label><select asp-for="Course.Location" class="form-select"><option value="">Select location</option>@foreach(string item in Course.Locations){<option value="@item">@item</option>}</select><span asp-validation-for="Course.Location" class="text-danger"></span></div>
<div class="col-md-3 mb-3"><label asp-for="Course.Hours" class="form-label"></label><input asp-for="Course.Hours" class="form-control"/><span asp-validation-for="Course.Hours" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="Course.InstructorID" class="form-label">Instructor</label><select asp-for="Course.InstructorID" class="form-select"><option value="0">Select instructor</option>@foreach(var u in Model.Instructors){<option value="@u.AppUserID">@u.Name</option>}</select><span asp-validation-for="Course.InstructorID" class="text-danger"></span></div>
<div class="col-md-6 mb-3"><label asp-for="Course.MajorID" class="form-label">Major</label><select asp-for="Course.MajorID" class="form-select"><option value="0">Select major</option>@foreach(var m in Model.Majors){<option value="@m.MajorID">@m.Name</option>}</select><span asp-validation-for="Course.MajorID" class="text-danger"></span></div>
<div class="col-12 mb-3"><label asp-for="Course.ShortDescription" class="form-label">Short Description</label><textarea asp-for="Course.ShortDescription" class="form-control" rows="3"></textarea><span asp-validation-for="Course.ShortDescription" class="text-danger"></span></div></div><button class="btn btn-primary" type="submit">Save</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>
