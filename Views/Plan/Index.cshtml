@model List<Course>
@{ ViewData["Title"] = "My Plan"; }
<h1>My Plan</h1>
<p>This plan is stored in session and backed up by a two-week persistent cookie. It is not a database table.</p>
@if (Model.Count == 0){<div class="alert alert-secondary">Your plan is empty.</div>}
else {
<div class="table-responsive"><table class="table table-striped"><thead><tr><th>Course</th><th>Name</th><th>Credits</th><th>Semester</th><th>Location</th><th></th></tr></thead><tbody>
@foreach(var course in Model){<tr><td>@course.CourseNumber</td><td>@course.CourseName</td><td>@course.Credits</td><td>@course.SemesterOffered</td><td>@course.Location</td><td class="text-nowrap"><form asp-controller="Reservations" asp-action="Reserve" method="post" class="d-inline"><input type="hidden" name="id" value="@course.CourseID"/><button class="btn btn-sm btn-success" type="submit">Reserve</button></form> <form asp-action="Remove" method="post" class="d-inline"><input type="hidden" name="id" value="@course.CourseID"/><button class="btn btn-sm btn-outline-danger" type="submit">Remove</button></form></td></tr>}
</tbody></table></div>
<form asp-action="Clear" method="post" class="d-inline"><button type="submit" class="btn btn-danger">Clear Plan</button></form>
}
<a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary">Back to Catalog</a>
