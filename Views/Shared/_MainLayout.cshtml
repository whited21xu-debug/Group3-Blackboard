@using Group3Blackboard.Models
@{
    Layout = "_Layout";
    string controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var session = new BlackboardSession(Context.Session);
    int planCount = session.GetPlanCount();
}
<nav class="navbar navbar-expand-lg navbar-dark student-navbar" aria-label="Student navigation">
    <div class="container-fluid">
        <a class="navbar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index">Group3Blackboard</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#studentNav" aria-controls="studentNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="studentNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item"><a class="nav-link @(controller == "Home" || controller == "Dashboard" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="nav-item"><a class="nav-link @(controller == "Catalog" || controller == "Plan" ? "active" : "")" asp-area="" asp-controller="Catalog" asp-action="Index">Catalog <span class="badge bg-light text-dark">@planCount</span></a></li>
                <li class="nav-item"><a class="nav-link @(controller == "Calendar" ? "active" : "")" asp-area="" asp-controller="Calendar" asp-action="Index">Calendar</a></li>
                <li class="nav-item"><a class="nav-link @(controller == "Reservations" ? "active" : "")" asp-area="" asp-controller="Reservations" asp-action="Index">Reservations</a></li>
            </ul>
            <ul class="navbar-nav ms-auto"><li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li></ul>
        </div>
    </div>
</nav>
<main class="page-content" role="main">@RenderBody()</main>
