<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Group3Blackboard</title>
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <div class="site-frame">
        <nav class="navbar navbar-expand-lg navbar-dark student-navbar" aria-label="Student navigation">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="Student" asp-controller="Dashboard" asp-action="Index">Group3Blackboard</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#studentNav" aria-controls="studentNav" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="studentNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item"><a class="nav-link" asp-area="Student" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="Student" asp-controller="Catalog" asp-action="Index">Catalog</a></li>
                        <li class="nav-item"><a class="nav-link" asp-area="Student" asp-controller="Calendar" asp-action="Index">Calendar</a></li>
                    </ul>
                    <ul class="navbar-nav ms-auto"><li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a></li></ul>
                </div>
            </div>
        </nav>
        <main class="page-content" role="main">@RenderBody()</main>
        <footer class="site-footer">© 2026 - Group3Blackboard</footer>
    </div>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
